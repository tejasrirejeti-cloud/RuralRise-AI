# ==============================================================================
# RURALRISE AI — ENVIRONMENT CONFIGURATION & DEPLOYMENT GUIDE
# ==============================================================================
#
# ENVIRONMENT VARIABLE MATRIX:
# ------------------------------------------------------------------------------
# VARIABLE         | PREVIEW / LOCAL DEV  | PRODUCTION DEPLOYMENT
# ------------------------------------------------------------------------------
# NODE_ENV         | 'development'        | 'production'
# PORT             | 3000                 | 3000 (or provided by host)
# APP_URL          | http://localhost:3000| https://your-production-domain.com
# SESSION_SECRET   | Optional (ephemeral) | STRICTLY REQUIRED (32+ chars)
# GEMINI_API_KEY   | Optional (non-AI OK) | Required for AI Plan Refinement
# SMTP_HOST        | Optional             | Required for real email delivery
# SMTP_PORT        | Optional (587)       | Required (587 or 465)
# SMTP_USER        | Optional             | Required
# SMTP_PASS        | Optional             | Required
# SMTP_FROM        | Optional             | Required
# DATABASE_PATH    | ./data/ruralrise.db  | Persistent volume mount path
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV="development"
PORT=3000
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SESSION SECURITY
# ------------------------------------------------------------------------------
# In production (NODE_ENV=production), SESSION_SECRET is strictly REQUIRED.
# It must be a strong, unique, high-entropy secret of at least 32 characters.
# Never use default placeholders in production (the server will refuse to start).
#
# Generate a secure 64-character secret in your terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# ------------------------------------------------------------------------------
# 3. AI REFINEMENT (Google Gemini API)
# ------------------------------------------------------------------------------
# Automatically injected when running within Google AI Studio Build.
# When running standalone: provide an API key from Google AI Studio.
# Note: The platform's landing page, directory of 5+ Warangal enterprise models,
# government scheme catalog, market evidence register, and deterministic
# financial feasibility calculator operate with 100% full functionality WITHOUT
# requiring this key. Only the AI-assisted plan refinement requires this key.
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 4. OUTBOUND EMAIL DELIVERY (Password Recovery Dispatch)
# ------------------------------------------------------------------------------
# Optional for local preview and testing. When omitted, password recovery returns
# safe generic responses notifying callers that outbound email is not configured.
#
# To enable real recovery email delivery in staging or production:
# All four SMTP variables below must be provided. Setting SMTP_HOST alone is not
# sufficient to establish delivery.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="RuralRise AI <noreply@ruralrise.in>"

# Optional alternative HTTP email provider:
# RESEND_API_KEY=""

# ------------------------------------------------------------------------------
# 5. DATABASE PERSISTENCE (SQLite Engine)
# ------------------------------------------------------------------------------
# Relative or absolute file path to the SQLite database.
# In containerized hosting platforms (e.g., Google Cloud Run, Railway, Render),
# ensure the directory containing this database is mounted to persistent disk storage,
# as containers have ephemeral filesystems by default.
DATABASE_PATH="./data/ruralrise.sqlite"
